<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Screens.WinUI.Views.WallpaperPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Screens.WinUI.Services"
    mc:Ignorable="d"
    Title="Wallpaper Preview"
    PrimaryButtonText="Set Desktop"
    SecondaryButtonText="Set Lock Screen"
    CloseButtonText="Close"
    MaxWidth="1000"
    MaxHeight="800">

    <Grid Width="950" Height="700">
        <!-- MediaPlayerElement for GIF/Video playback -->
        <MediaPlayerElement x:Name="MediaPlayerElement"
                          AutoPlay="True"
                          AreTransportControlsEnabled="True"
                          Stretch="Uniform"/>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing"
                      IsActive="True"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Live wallpaper badge -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#A83636"
                CornerRadius="12"
                Padding="12,8"
                Margin="16"
                x:Name="LiveBadge"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8"
                         Height="8"
                         Fill="White">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                   From="1"
                                                   To="0.3"
                                                   Duration="0:0:0.8"
                                                   AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="LIVE WALLPAPER"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
