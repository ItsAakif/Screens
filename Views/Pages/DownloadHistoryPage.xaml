<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Screens.WinUI.Views.Pages.DownloadHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Screens.WinUI.Models"
    mc:Ignorable="d"
    x:Name="PageRoot">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Download History"
                           Style="{StaticResource SubheaderTextStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.TotalDownloadsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Clear History"
                    Command="{x:Bind ViewModel.ClearHistoryCommand}"/>
        </Grid>

        <!-- Loading -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="48" Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Empty State -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                   Style="{StaticResource SubheaderTextStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>

        <!-- Download History Grid -->
        <ScrollViewer Grid.Row="1">
            <GridView ItemsSource="{x:Bind ViewModel.DownloadHistory, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0,8">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Wallpaper">
                        <Border Width="280" Height="220"
                                Background="{ThemeResource CardFillColorDefaultBrush}"
                                CornerRadius="12" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Grid.Row="0"
                                       Source="{x:Bind ImageUrl}"
                                       Stretch="UniformToFill"/>

                                <Border Grid.Row="1"
                                        Background="{ThemeResource CardFillColorSecondaryBrush}"
                                        Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="Set Desktop"
                                                    Command="{Binding DataContext.SetAsDesktopWallpaperCommand, ElementName=PageRoot}"
                                                    CommandParameter="{x:Bind}"/>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveFromHistoryCommand, ElementName=PageRoot}"
                                                    CommandParameter="{x:Bind}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
