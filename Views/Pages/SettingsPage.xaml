<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Screens.WinUI.Views.Pages.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40">
        <ScrollViewer>
            <StackPanel Spacing="16">

                <!-- General Settings -->
                <Border Background="{ThemeResource CardFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="General"
                                   Style="{StaticResource SubheaderTextStyle}"/>

                        <ComboBox Header="Wallpaper Provider"
                                  ItemsSource="{x:Bind ViewModel.AvailableProviders, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"/>

                        <ComboBox Header="Theme">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="System Default"/>
                        </ComboBox>

                        <ComboBox Header="Grid Size">
                            <ComboBoxItem Content="Small"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Large"/>
                        </ComboBox>

                        <Button Content="Save Settings"
                                Command="{x:Bind ViewModel.SaveSettingsAsyncCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Live Wallpaper Status -->
                <Border Background="{ThemeResource CardFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Live Wallpaper"
                                   Style="{StaticResource SubheaderTextStyle}"/>

                        <InfoBar Severity="{x:Bind ViewModel.LiveWallpaperSeverity, Mode=OneWay}"
                                 IsOpen="True"
                                 Title="{x:Bind ViewModel.LiveWallpaperStatusTitle, Mode=OneWay}"
                                 Message="Live wallpapers use GPU acceleration for smooth playback"/>

                        <Button Content="Stop Live Wallpaper"
                                Command="{x:Bind ViewModel.StopLiveWallpaperAsyncCommand}"
                                Visibility="{x:Bind ViewModel.StopButtonVisibility, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!-- Cache -->
                <Border Background="{ThemeResource CardFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Cache"
                                   Style="{StaticResource SubheaderTextStyle}"/>
                        <TextBlock Text="Image cache stores downloaded wallpapers locally"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <Button Content="Clear Cache"
                                Command="{x:Bind ViewModel.ClearCacheAsyncCommand}"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Background="{ThemeResource CardFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="About"
                                   Style="{StaticResource SubheaderTextStyle}"/>
                        <TextBlock Text="Screens Wallpaper Manager v1.0.0"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="Built with WinUI 3 and Windows App SDK"
                                   Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
